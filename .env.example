# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Enterprise CDC Platform: Environment Configuration & Overrides
# ==============================================================================
ENVIRONMENT="local-m2"
LOG_LEVEL="INFO"
MEMORY_CAP_MB="11520"

# Configuration Files
CDC_PLATFORM_PROPERTIES_PATH="config/cdc-platform.properties"
DATABASE_CONNECTORS_PROPERTIES_PATH="config/database-connectors.properties"
PLATFORM_CONFIG_JSON_PATH="config/platform-config.json"

# Kafka KRaft & Debezium Connect
KAFKA_BOOTSTRAP_SERVERS="kafka:9092,localhost:9092"
CONNECT_REST_URL="http://localhost:8083"
SCHEMA_REGISTRY_URL="http://localhost:8081"

# Database Connectivity URLs & Credentials (12-Factor externalization)
POSTGRES_SOURCE_URL="postgresql://postgres:postgrespassword@postgres-source:5432/orders_db"
POSTGRES_SOURCE_HOST="postgres-source"
POSTGRES_SOURCE_PORT="5432"
POSTGRES_SOURCE_USER="postgres"
POSTGRES_SOURCE_PASSWORD="postgrespassword"
POSTGRES_SOURCE_DB="orders_db"

MYSQL_SOURCE_URL="mysql://mysqluser:mysqlpassword@mysql-source:3306/inventory"
MYSQL_SOURCE_HOST="mysql-source"
MYSQL_SOURCE_PORT="3306"
MYSQL_SOURCE_USER="mysqluser"
MYSQL_SOURCE_PASSWORD="mysqlpassword"
MYSQL_SOURCE_DB="inventory"

MARIADB_SOURCE_URL="mariadb://mariadbuser:mariadbpassword@mariadb-source:3306/store_catalog"
MARIADB_SOURCE_HOST="mariadb-source"
MARIADB_SOURCE_PORT="3306"
MARIADB_SOURCE_USER="mariadbuser"
MARIADB_SOURCE_PASSWORD="mariadbpassword"
MARIADB_SOURCE_DB="store_catalog"

MONGODB_SOURCE_URL="mongodb://mongo-source:27017/?replicaSet=rs0"
MONGODB_SOURCE_HOST="mongo-source"
MONGODB_SOURCE_PORT="27017"
MONGODB_SOURCE_DB="store"

ORACLE_SOURCE_URL="oracle://c##dbzuser:dbzpassword@oracle-source:1521/ORCLPDB1"
ORACLE_SOURCE_HOST="oracle-source"
ORACLE_SOURCE_PORT="1521"
ORACLE_SOURCE_USER="c##dbzuser"
ORACLE_SOURCE_PASSWORD="dbzpassword"
ORACLE_SOURCE_DB="ORCLCDB"

SQLSERVER_SOURCE_URL="sqlserver://sa:Password123!@sqlserver-source:1433/crm_db"
SQLSERVER_SOURCE_HOST="sqlserver-source"
SQLSERVER_SOURCE_PORT="1433"
SQLSERVER_SOURCE_USER="sa"
SQLSERVER_SOURCE_PASSWORD="Password123!"
SQLSERVER_SOURCE_DB="crm_db"

METADATA_DATABASE_URL="postgresql://cdc_admin:cdcadminpassword@metadata-db:5432/cdc_control_plane"
